{
  "name": "@bloxwap/chart-docs",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "npm --workspace @bloxwap/chart run build && node scripts/prepare-demo.mjs",
    "dev": "next dev --port 3901",
