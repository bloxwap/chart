    "build": "next build",
    "postbuild": "node scripts/check-export.mjs",
    "check": "next typegen && tsc --noEmit",
    "preview": "node scripts/preview.mjs",
    "postinstall": "fumadocs-mdx"
  },
  "dependencies": {
    "@bloxwap/chart": "0.1.0",
    "fumadocs-core": "16.15.14",
    "fumadocs-mdx": "15.4.5",
    "fumadocs-ui": "16.15.14",
    "next": "16.3.6",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.2.0",
    "@types/mdx": "^2.0.13",
    "@types/node": "^24.13.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "tailwindcss": "^4.2.0",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=24"
  }
}
