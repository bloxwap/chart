{
  "name": "@bloxwap/chart-docs",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "npm --workspace @bloxwap/chart run build && node scripts/prepare-demo.mjs",
    "dev": "next dev --port 3902",
    "prebuild": "npm --workspace @bloxwap/chart run build && node scripts/prepare-demo.mjs && npm run check",
    "build": "next build",
    "postbuild": "node scripts/check-export.mjs",
    "check": "next typegen && tsrs --noEmit",
    "check:tsc": "next typegen && tsc --noEmit",
    "preview": "node scripts/preview.mjs",
    "postinstall": "fumadocs-mdx"
  },
  "dependencies": {
    "@bloxwap/chart": "0.4.0",
    "@bloxwap/font": "0.1.2",
    "@bloxwap/hig-contracts": "0.1.0",
    "@bloxwap/hig-react": "0.1.0",
    "@bloxwap/hig-tokens": "0.1.0",
    "fumadocs-core": "16.17.7",
    "fumadocs-mdx": "15.4.9",
    "fumadocs-ui": "16.17.7",
    "lucide-react": "1.61.0",
    "next": "16.4.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@bloxwap/hig-og-fonts": "0.1.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/mdx": "^2.0.14",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "tsrs": "0.18.0-ts7.1.0-dev.20260929",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=24"
  }
}
