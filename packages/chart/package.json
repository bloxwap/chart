{
  "name": "@bloxwap/chart",
  "version": "0.1.0",
  "description": "Zero-dependency, WASM-accelerated candlestick/financial charting library in TypeScript with injected DOM",
  "type": "module",
  "sideEffects": false,
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/bloxwap/chart.git",
    "directory": "packages/chart"
  },
  "homepage": "https://bloxwap.github.io/chart/",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./config": {
      "types": "./dist/config.d.ts",
      "import": "./dist/config.js"
    },
    "./color": {
      "types": "./dist/color.d.ts",
      "import": "./dist/color.js"
    },
    "./dom": {
      "types": "./dist/dom.d.ts",
      "import": "./dist/dom.js"
    },
    "./indicators": {
      "types": "./dist/indicators/index.d.ts",
      "import": "./dist/indicators/index.js"
    },
    "./drawings": {
      "types": "./dist/drawings/index.d.ts",
      "import": "./dist/drawings/index.js"
    },
    "./wasm": {
      "types": "./dist/wasm/loader.d.ts",
      "import": "./dist/wasm/loader.js"
    },
    "./ui": {
      "types": "./dist/ui/index.d.ts",
      "import": "./dist/ui/index.js"
    },
    "./icons": {
      "types": "./dist/ui/icons.d.ts",
      "import": "./dist/ui/icons.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js"
    },
    "./datafeed": {
      "types": "./dist/datafeed/index.d.ts",
      "import": "./dist/datafeed/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "PERFORMANCE.md"
  ],
  "scripts": {
    "build": "npm run build:icons && npm run build:wasm && npm run build:ts",
    "build:ts": "tsc -p tsconfig.json",
    "build:ts-test": "tsc -p tsconfig.test.json",
    "build:wasm": "node scripts/build-wasm.mjs",
    "build:icons": "npm run lint:icons && node scripts/build-icons.mjs",
    "lint:icons": "node scripts/lint-icons.mjs",
    "preview:icons": "node scripts/preview-icons.mjs",
    "test": "npm run build && npm run build:ts-test && node --test \"dist-test/**/*.test.js\"",
    "coverage": "npm run build && npm run build:ts-test && node scripts/check-coverage.mjs",
    "coverage:lcov": "npm run build && npm run build:ts-test && mkdir -p coverage && node --enable-source-maps --test --experimental-test-coverage --test-coverage-exclude='**/kernels.base64.*' --test-coverage-exclude='dist-test/**' --test-coverage-exclude='test/**' --test-reporter=dot --test-reporter=lcov --test-reporter-destination=stdout --test-reporter-destination=coverage/lcov.info \"dist-test/**/*.test.js\" && node scripts/lcov-sanitize.mjs",
    "bench": "npm run build && node bench/indicators.bench.mjs && node bench/rolling.bench.mjs && node bench/render.bench.mjs && node bench/workloads.bench.mjs",
    "prepublishOnly": "npm test",
    "prepack": "npm run build",
    "bench:browser": "npm run build && node bench/run-browser.mjs"
  },
  "keywords": [
    "chart",
    "candlestick",
    "financial",
    "trading",
    "wasm",
    "simd",
    "canvas",
    "typescript"
  ],
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^20.14.5",
    "@types/node": "^24.13.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "happy-dom": "^20.14.5",
    "playwright-core": "^1.63.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^6.0.3",
    "wabt": "^1.0.39"
  }
}
