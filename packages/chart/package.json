{
  "name": "@bloxwap/chart",
  "version": "0.1.0",
  "description": "Zero-dependency, WASM-accelerated candlestick/financial charting library in TypeScript with injected DOM",
  "type": "module",
  "sideEffects": false,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/bloxwap/chart.git",
    "directory": "packages/chart"
  },
  "homepage": "https://bloxwap.github.io/chart/",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./config": {
      "types": "./dist/config.d.ts",
      "import": "./dist/config.js"
    },
    "./color": {
      "types": "./dist/color.d.ts",
      "import": "./dist/color.js"
    },
    "./dom": {
      "types": "./dist/dom.d.ts",
      "import": "./dist/dom.js"
    },
    "./indicators": {
      "types": "./dist/indicators/index.d.ts",
      "import": "./dist/indicators/index.js"
    },
    "./drawings": {
      "types": "./dist/drawings/index.d.ts",
      "import": "./dist/drawings/index.js"
    },
    "./wasm": {
      "types": "./dist/wasm/loader.d.ts",
      "import": "./dist/wasm/loader.js"
    },
    "./ui": {
      "types": "./dist/ui/index.d.ts",
      "import": "./dist/ui/index.js"
    },
    "./icons": {
      "types": "./dist/ui/icons.d.ts",
      "import": "./dist/ui/icons.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "PERFORMANCE.md"
  ],
  "scripts": {
    "build": "npm run build:icons && npm run build:wasm && npm run build:ts",
    "build:ts": "tsc -p tsconfig.json",
    "build:ts-test": "tsc -p tsconfig.test.json",
    "build:wasm": "node scripts/build-wasm.mjs",
    "build:icons": "node scripts/build-icons.mjs",
    "test": "npm run build && npm run build:ts-test && node --test \"dist-test/**/*.test.js\"",
    "coverage": "npm run build && npm run build:ts-test && node scripts/check-coverage.mjs",
    "bench": "npm run build && node bench/indicators.bench.mjs && node bench/rolling.bench.mjs && node bench/render.bench.mjs",
    "prepublishOnly": "npm test",
    "prepack": "npm run build"
  },
  "keywords": [
    "chart",
    "candlestick",
    "financial",
    "trading",
    "wasm",
    "simd",
    "canvas",
    "typescript"
  ],
  "devDependencies": {
    "@types/node": "^24.13.6",
    "happy-dom": "^20.14.5",
    "typescript": "^6.0.3",
    "wabt": "^1.0.39"
  },
  "engines": {
    "node": ">=24"
  }
}
