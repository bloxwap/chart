{
  "name": "bloxwap-chart-workspace",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm --workspace @bloxwap/chart run build",
    "build:ts": "npm --workspace @bloxwap/chart run build:ts",
    "build:ts-test": "npm --workspace @bloxwap/chart run build:ts-test",
    "build:wasm": "npm --workspace @bloxwap/chart run build:wasm",
    "build:icons": "npm --workspace @bloxwap/chart run build:icons",
    "test": "npm --workspace @bloxwap/chart run test",
    "coverage": "npm --workspace @bloxwap/chart run coverage",
    "bench": "npm --workspace @bloxwap/chart run bench",
    "demo": "npm --workspace @bloxwap/chart-playground run dev",
    "docs:dev": "npm --workspace @bloxwap/chart-docs run dev",
    "docs:build": "npm --workspace @bloxwap/chart-docs run build",
    "docs:check": "npm --workspace @bloxwap/chart-docs run check",
    "docs:preview": "npm --workspace @bloxwap/chart-docs run preview",
    "pack:chart": "npm pack --workspace @bloxwap/chart --pack-destination packages/chart"
  },
  "engines": {
    "node": ">=24"
  }
}
